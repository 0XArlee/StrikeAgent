# Smart Flow public API, read-only: Strike City feed (/api/city) built from the paper agents' journals.
# No keys on this host and nothing here can place an order. Install: deploy/install_ct.sh
[Unit]
Description=Smart Flow API (read-only, Strike City feed on :8787)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartflow
Group=smartflow
WorkingDirectory=/opt/smartflow/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/smartflow/app/.venv/bin/smartflow api --city config/city.toml --host 0.0.0.0 --port 8787
Restart=always
RestartSec=10
# hardening: it only reads the journals and state files
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/smartflow/app
MemoryMax=200M

[Install]
WantedBy=multi-user.target
