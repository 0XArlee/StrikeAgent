# Smart Flow -> the News Tower's data: headlines from public feeds, scored by Claude Haiku (if /etc/smartflow/news.env has
# ANTHROPIC_API_KEY; root:smartflow 0640, written from the operator's PC, docs/OPERATIONS.md), reactions measured on Strike's public
# prices. Writes /var/lib/smartflow/news/news.json, which the push services send to the sites. Never reads or touches
# the agents. Outbound HTTPS only. Install: deploy/install_ct.sh
[Unit]
Description=Smart Flow news (News Tower data, outbound only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartflow
Group=smartflow
WorkingDirectory=/opt/smartflow/app
EnvironmentFile=-/etc/smartflow/news.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/smartflow/app/.venv/bin/smartflow news --dir /var/lib/smartflow/news
Restart=always
RestartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/smartflow/app
ReadWritePaths=/var/lib/smartflow/news
MemoryMax=200M

[Install]
WantedBy=multi-user.target
